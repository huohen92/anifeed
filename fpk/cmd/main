#!/bin/bash

CONTAINER_NAME="anifeed"

is_running() {
  docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -q '^true$'
}

case "$1" in
start)
  exit 0
  ;;
stop)
  exit 0
  ;;
status)
  if is_running; then
    exit 0
  fi
  exit 3
  ;;
*)
  echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/tmp/anifeed-fpk.log}"
  exit 1
  ;;
esac
